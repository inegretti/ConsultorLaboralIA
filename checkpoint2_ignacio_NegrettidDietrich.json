    {
      "parameters": {
        "jsCode": "const registros = $input.all();\n\nconst bloques = registros.map(item => {\n  const f = item.json.fields || {};\n\n  const consulta = (f.Consulta || '').slice(0, 400);\n  const respuesta = (f.Respuesta || '').slice(0, 500);\n  const tipo = f.Tipo || '';\n\n  return `Consulta: ${consulta}\nRespuesta: ${respuesta}\nTipo: ${tipo}`;\n});\n\n// Agregar bloques completos hasta un máximo\nconst limite = 6000;\nconst seleccionados = [];\nlet caracteres = 0;\n\nfor (let i = bloques.length - 1; i >= 0; i--) {\n  const bloque = bloques[i];\n  const adicional = bloque.length + 2;\n\n  if (caracteres + adicional > limite) {\n    break;\n  }\n\n  seleccionados.unshift(bloque);\n  caracteres += adicional;\n}\n\nreturn [{\n  json: {\n    historial: seleccionados.join('\\n\\n')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3232,
        -112
      ],
      "id": "7cc69bdd-deed-466e-a5a3-b50df04e6fff",
      "name": "Ajustes de formato de tabla para LLM"
    },
    {
      "parameters": {
        "jsCode": "const resumen = JSON.parse($json.text);\n\nconst puntosClave = resumen.puntos_clave\n  .map(punto => `- ${punto}`)\n  .join('\\n');\n\nconst resumenTexto = `Asunto principal: ${resumen.asunto_principal}\n\nPuntos clave:\n${puntosClave}\n\nAcción requerida:\n${resumen.accion_requerida}`;\n\nreturn [\n  {\n    json: {\n      Resumen_Consolidado: resumenTexto,\n      asunto_principal: resumen.asunto_principal,\n      puntos_clave: resumen.puntos_clave,\n      accion_requerida: resumen.accion_requerida\n    }\n  }\n];"
      },
